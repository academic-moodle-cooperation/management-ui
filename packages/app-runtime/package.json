{
  "name": "@opencast-mui/app-runtime",
  "version": "1.0.0",
  "description": "Plugin runtime context and standalone-app bootstrap (AppRuntimeProvider, useAppRuntime, StandaloneAppWrapper) for the Opencast Management UI and its plugins.",
  "author": "Academic Moodle Cooperation",
  "homepage": "https://github.com/academic-moodle-cooperation/management-tool/tree/HEAD/packages/app-runtime#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/academic-moodle-cooperation/management-tool.git",
    "directory": "packages/app-runtime"
  },
  "bugs": "https://github.com/academic-moodle-cooperation/management-tool/issues",
  "keywords": [
    "opencast",
    "management-ui",
    "opencast-mui",
    "plugin",
    "runtime",
    "standalone"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist-types/src/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist-types/src/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "license": "ECL-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist-types/src/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "dist-types"
  ],
  "scripts": {
    "clean": "rm -rf .turbo && rm -rf dist && rm -rf dist-types && rm -rf target && rm -rf node_modules && rm -rf coverage && rm -f *.tsbuildinfo && rm -f tsconfig*.tsbuildinfo",
    "build": "tsup",
    "build:types": "tsc -p tsconfig.build.json",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "check-types": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@opencast-mui/plugin-system": "workspace:*",
    "@opencast-mui/query": "workspace:*",
    "@opencast-mui/router": "workspace:*",
    "@opencast-mui/ui": "workspace:*",
    "@opencast-mui/utils": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@types/node": "^25.0.6",
    "@types/react": "^18.0.0 || ^19.0.0",
    "@types/react-dom": "^18.0.0 || ^19.0.0",
    "@opencast-mui/eslint-config": "workspace:*",
    "@opencast-mui/typescript-config": "workspace:*",
    "eslint": "^9.20.0",
    "tsup": "^8.5.0",
    "typescript": "^5.3.3"
  }
}
