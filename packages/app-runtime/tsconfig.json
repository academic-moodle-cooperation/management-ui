{
  "extends": "../typescript-config/react-library.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@workspace/utils": [
        "../utils/src/index.ts"
      ],
      "@workspace/utils/*": [
        "../utils/src/*"
      ]
    },
    "composite": false,
    "noEmit": true
  },
  "include": [
    "src",
    "vite-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".turbo"
  ]
}