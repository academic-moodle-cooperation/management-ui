{
  "extends": "../typescript-config/react-library.json",
  "compilerOptions": {
    "baseUrl": ".",
    "skipLibCheck": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "composite": false,
    "noEmit": true
  },
  "include": [
    "src",
    "vite-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".turbo",
    "../ui/src/components/ui/**/*"
  ]
}