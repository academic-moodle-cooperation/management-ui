{
  "extends": "@oc-mui/typescript-config/node-esm-library.json",
  "compilerOptions": {
    "outDir": "./dist",
    "declaration": true,
    "composite": false,
    "module": "node16",
    "moduleResolution": "node16",
    "target": "ES2022",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
