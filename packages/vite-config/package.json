{
  "name": "@workspace/vite-config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./base": "./dist/base.config.js",
    "./proxy": "./dist/proxy.js",
    "./ports": "./dist/ports.js",
    "./index": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
