{
  "name": "@oc-mui/vite-config",
  "version": "1.1.0",
  "description": "Shared Vite build configuration for the Opencast Management UI and standalone community plugins.",
  "author": "Academic Moodle Cooperation",
  "homepage": "https://github.com/academic-moodle-cooperation/management-ui/tree/HEAD/packages/vite-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/academic-moodle-cooperation/management-ui.git",
    "directory": "packages/vite-config"
  },
  "bugs": "https://github.com/academic-moodle-cooperation/management-ui/issues",
  "keywords": [
    "opencast",
    "management-ui",
    "oc-mui",
    "plugin",
    "vite",
    "build-config"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "ECL-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./base": "./dist/base.config.js",
    "./proxy": "./dist/proxy.js",
    "./ports": "./dist/ports.js",
    "./index": "./dist/index.js",
    "./community-plugin": "./dist/community-plugin.config.js",
    "./plugins/fragment-extractor": "./dist/plugins/fragment-extractor.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf .turbo && rm -rf dist && rm -rf dist-types && rm -rf target && rm -rf node_modules && rm -rf coverage && rm -f *.tsbuildinfo && rm -f tsconfig*.tsbuildinfo",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "@oc-mui/utils": "workspace:*",
    "vite-plugin-static-copy": "^1.0.6"
  },
  "peerDependencies": {
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@types/node": "^25.0.6",
    "@oc-mui/eslint-config": "workspace:*",
    "@oc-mui/typescript-config": "workspace:*",
    "eslint": "^9.8.0",
    "typescript": "~5.5.4",
    "vite": "^6.3.5",
    "vitest": "^4.0.17"
  }
}
