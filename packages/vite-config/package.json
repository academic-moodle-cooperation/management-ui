    "vite-plugin-static-copy": "^1.0.6"
  },
  "devDependencies": {
    "@types/node": "^25.0.6",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.8.0",
    "typescript": "~5.5.4"
  }
}
