{
  "name": "@oc-mui/ui-config",
  "version": "1.0.0",
  "description": "Application configuration schema, types, and defaults for the Opencast Management UI.",
  "author": "Academic Moodle Cooperation",
  "homepage": "https://github.com/academic-moodle-cooperation/management-ui/tree/HEAD/packages/ui-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/academic-moodle-cooperation/management-ui.git",
    "directory": "packages/ui-config"
  },
  "bugs": "https://github.com/academic-moodle-cooperation/management-ui/issues",
  "keywords": [
    "opencast",
    "management-ui",
    "oc-mui",
    "plugin",
    "config"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist-types/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist-types/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "license": "ECL-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "dist-types"
  ],
  "scripts": {
    "clean": "rm -rf .turbo && rm -rf dist && rm -rf dist-types && rm -rf node_modules && rm -rf coverage && rm -f *.tsbuildinfo && rm -f tsconfig*.tsbuildinfo",
    "build": "tsup",
    "lint": "eslint . --ext .ts,.js,.tsx --report-unused-disable-directives --max-warnings 0",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "build:types": "tsc -p tsconfig.build.json",
    "api-check": "pnpm build:types && api-extractor run --local --verbose",
    "api-check:ci": "pnpm build:types && api-extractor run --verbose",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.6",
    "@types/react": "^18.0.0 || ^19.0.0",
    "@oc-mui/eslint-config": "workspace:*",
    "@oc-mui/typescript-config": "workspace:*",
    "eslint": "^9.9.0",
    "tsup": "^8.5.0",
    "typescript": "~5.5.4",
    "vitest": "^4.0.17"
  }
}
