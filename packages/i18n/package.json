{
  "name": "@oc-mui/i18n",
  "version": "1.0.0",
  "description": "Internationalization facade (i18next) for the Opencast Management UI and its plugins.",
  "author": "Academic Moodle Cooperation",
  "homepage": "https://github.com/academic-moodle-cooperation/management-ui/tree/HEAD/packages/i18n#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/academic-moodle-cooperation/management-ui.git",
    "directory": "packages/i18n"
  },
  "bugs": "https://github.com/academic-moodle-cooperation/management-ui/issues",
  "keywords": [
    "opencast",
    "management-ui",
    "oc-mui",
    "plugin",
    "i18n",
    "i18next"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "ECL-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist-types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf .turbo && rm -rf dist && rm -rf dist-types && rm -rf node_modules && rm -rf coverage && rm -f *.tsbuildinfo && rm -f tsconfig*.tsbuildinfo",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "build:types": "tsc -p tsconfig.build.json",
    "api-check": "pnpm build:types && api-extractor run --local --verbose",
    "api-check:ci": "pnpm build:types && api-extractor run --verbose",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "files": [
    "dist",
    "dist-types"
  ],
  "dependencies": {
    "i18next": "^23.10.0",
    "i18next-browser-languagedetector": "^7.2.0",
    "i18next-http-backend": "^2.5.0",
    "react-i18next": "^14.0.5"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.1",
    "@types/node": "^25.0.6",
    "@types/react": "^18.0.0 || ^19.0.0",
    "@oc-mui/eslint-config": "workspace:*",
    "@oc-mui/typescript-config": "workspace:*",
    "eslint": "^9.9.0",
    "jsdom": "^27.4.0",
    "tsup": "^8.5.0",
    "typescript": "~5.5.4",
    "vite": "^6.3.5",
    "vitest": "^4.0.17"
  }
}
