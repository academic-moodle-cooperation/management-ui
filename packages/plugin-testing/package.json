{
  "name": "@oc-mui/plugin-testing",
  "version": "1.0.0",
  "description": "Test harness for Opencast Management UI plugins — load a plugin in isolation and assert its manifest and runtime contracts.",
  "author": "Academic Moodle Cooperation",
  "homepage": "https://github.com/academic-moodle-cooperation/management-tool/tree/release/oss-1.0/packages/plugin-testing#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/academic-moodle-cooperation/management-tool.git",
    "directory": "packages/plugin-testing"
  },
  "bugs": "https://github.com/academic-moodle-cooperation/management-tool/issues",
  "keywords": [
    "opencast",
    "management-ui",
    "oc-mui",
    "plugin",
    "testing",
    "vitest"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "ECL-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "clean": "rm -rf .turbo && rm -rf dist && rm -rf dist-types && rm -rf node_modules && rm -rf coverage && rm -f *.tsbuildinfo && rm -f tsconfig*.tsbuildinfo",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@oc-mui/plugin-system": "workspace:*",
    "@oc-mui/utils": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/react": "^18.0.0 || ^19.0.0",
    "@types/react-dom": "^18.0.0 || ^19.0.0",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "@oc-mui/eslint-config": "workspace:*",
    "@oc-mui/typescript-config": "workspace:*",
    "eslint": "^9.20.0",
    "jsdom": "^27.4.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.17"
  }
}
