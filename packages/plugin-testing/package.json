{
  "name": "@oc-mui/plugin-testing",
  "version": "1.0.1",
  "description": "Test harness for Opencast Management UI plugins — load a plugin in isolation and assert its manifest and runtime contracts.",
  "author": "Academic Moodle Cooperation",
  "homepage": "https://github.com/academic-moodle-cooperation/management-ui/tree/HEAD/packages/plugin-testing#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/academic-moodle-cooperation/management-ui.git",
    "directory": "packages/plugin-testing"
  },
  "bugs": "https://github.com/academic-moodle-cooperation/management-ui/issues",
  "keywords": [
    "opencast",
    "management-ui",
    "oc-mui",
    "plugin",
    "testing",
    "vitest"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "ECL-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist-types/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "dist-types"
  ],
  "scripts": {
    "clean": "rm -rf .turbo && rm -rf dist && rm -rf dist-types && rm -rf node_modules && rm -rf coverage && rm -f *.tsbuildinfo && rm -f tsconfig*.tsbuildinfo",
    "build": "tsup",
    "build:types": "tsc -p tsconfig.build.json",
    "api-check": "pnpm build:types && api-extractor run --local --verbose",
    "api-check:ci": "pnpm build:types && api-extractor run --verbose",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@oc-mui/plugin-system": "workspace:*",
    "@oc-mui/utils": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "@testing-library/react": "^16.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    },
    "@testing-library/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/react": "^18.0.0 || ^19.0.0",
    "@types/react-dom": "^18.0.0 || ^19.0.0",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "@oc-mui/eslint-config": "workspace:*",
    "@oc-mui/typescript-config": "workspace:*",
    "eslint": "^9.20.0",
    "jsdom": "^27.4.0",
    "tsup": "^8.5.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.17"
  }
}
