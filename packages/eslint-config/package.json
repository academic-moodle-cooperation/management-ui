{
  "name": "@oc-mui/eslint-config",
  "version": "1.0.0",
  "license": "ECL-2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "clean": "rm -rf .turbo && rm -rf dist && rm -rf dist-types && rm -rf target && rm -rf node_modules && rm -rf coverage && rm -f *.tsbuildinfo && rm -f tsconfig*.tsbuildinfo",
    "lint": "eslint . --ext .js --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run"
  },
  "exports": {
    "./base": "./base.js",
    "./react-internal": "./react-internal.js",
    "./type-aware": "./type-aware.js"
  },
  "files": [
    "base.js",
    "react-internal.js",
    "type-aware.js",
    "rules/index.js",
    "rules/graphql-operation-naming.js"
  ],
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@graphql-eslint/eslint-plugin": "^4.4.0",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-only-warn": "^1.1.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-turbo": "^2.5.0",
    "globals": "^16.2.0",
    "graphql": "^16.11.0",
    "typescript-eslint": "^8.32.0",
    "vitest": "^4.0.17"
  }
}
