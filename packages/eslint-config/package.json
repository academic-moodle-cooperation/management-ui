{
  "name": "@oc-mui/eslint-config",
  "version": "1.0.0",
  "description": "Shared ESLint configuration (wrapper-library and architectural boundary rules) for the Opencast Management UI and its plugins.",
  "author": "Academic Moodle Cooperation",
  "homepage": "https://github.com/academic-moodle-cooperation/management-tool/tree/HEAD/packages/eslint-config#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/academic-moodle-cooperation/management-tool.git",
    "directory": "packages/eslint-config"
  },
  "bugs": "https://github.com/academic-moodle-cooperation/management-tool/issues",
  "keywords": [
    "opencast",
    "management-ui",
    "oc-mui",
    "plugin",
    "eslint",
    "eslint-config"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "ECL-2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "clean": "rm -rf .turbo && rm -rf dist && rm -rf dist-types && rm -rf target && rm -rf node_modules && rm -rf coverage && rm -f *.tsbuildinfo && rm -f tsconfig*.tsbuildinfo",
    "lint": "eslint . --ext .js --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run"
  },
  "exports": {
    "./base": "./base.js",
    "./react-internal": "./react-internal.js",
    "./type-aware": "./type-aware.js"
  },
  "files": [
    "base.js",
    "react-internal.js",
    "type-aware.js",
    "rules/index.js",
    "rules/graphql-operation-naming.js"
  ],
  "dependencies": {
    "@eslint/js": "^9.27.0",
    "@graphql-eslint/eslint-plugin": "^4.4.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-only-warn": "^1.1.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-turbo": "^2.5.0",
    "globals": "^16.2.0",
    "graphql": "^16.11.0",
    "typescript-eslint": "^8.32.0"
  },
  "peerDependencies": {
    "eslint": "^9.0.0"
  },
  "devDependencies": {
    "eslint": "^9.27.0",
    "vitest": "^4.0.17"
  }
}
