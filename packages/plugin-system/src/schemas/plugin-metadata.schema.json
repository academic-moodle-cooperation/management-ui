{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Community Plugin Metadata",
  "type": "object",
  "required": ["id", "name", "description", "version", "author", "category"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique plugin identifier (lowercase, alphanumeric, hyphens)"
    },
    "name": {
      "type": "string",
      "description": "Human-readable plugin name"
    },
    "description": {
      "type": "string",
      "description": "Short description of what the plugin does"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version (MAJOR.MINOR.PATCH)"
    },
    "author": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "category": {
      "type": "string",
      "enum": ["feature", "theme", "integration", "utility", "experimental"],
      "description": "High-level category for marketplace grouping"
    },
    "icon": {
      "type": "string",
      "description": "Lucide icon name (optional)"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Searchable tags"
    },
    "repositoryUrl": {
      "type": "string",
      "format": "uri"
    },
    "homepageUrl": {
      "type": "string",
      "format": "uri"
    },
    "license": {
      "type": "string"
    },
    "workspaceDependencies": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Version constraints for @workspace/* packages"
    }
  },
  "additionalProperties": false
}

