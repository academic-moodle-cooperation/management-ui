{
  "extends": "@workspace/typescript-config/react-library.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@workspace/plugin-system/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".turbo"
  ]
}