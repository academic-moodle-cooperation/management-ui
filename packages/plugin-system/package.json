{
  "name": "@opencast-mui/plugin-system",
  "version": "1.0.0",
  "description": "Plugin runtime for the Opencast Management UI — createPlugin, PluginManager, and extension-point registration.",
  "author": "Academic Moodle Cooperation",
  "homepage": "https://github.com/academic-moodle-cooperation/management-tool/tree/HEAD/packages/plugin-system#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/academic-moodle-cooperation/management-tool.git",
    "directory": "packages/plugin-system"
  },
  "bugs": "https://github.com/academic-moodle-cooperation/management-tool/issues",
  "keywords": [
    "opencast",
    "management-ui",
    "opencast-mui",
    "plugin",
    "plugin-system",
    "extension-points"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist-types/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist-types/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "license": "ECL-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "dist-types"
  ],
  "scripts": {
    "clean": "rm -rf .turbo && rm -rf dist && rm -rf dist-types && rm -rf target && rm -rf node_modules && rm -rf coverage && rm -f *.tsbuildinfo && rm -f tsconfig*.tsbuildinfo",
    "build": "tsup",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "build:types": "tsc -p tsconfig.build.json",
    "api-check": "pnpm build:types && api-extractor run --local --verbose",
    "api-check:ci": "pnpm build:types && api-extractor run --verbose",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@opencast-mui/utils": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@types/react": "^18.0.0 || ^19.0.0",
    "@types/react-dom": "^18.0.0 || ^19.0.0",
    "@opencast-mui/eslint-config": "workspace:*",
    "@opencast-mui/tailwind-config": "workspace:*",
    "@opencast-mui/typescript-config": "workspace:*",
    "eslint": "^9.20.0",
    "tailwindcss": "^4.1.7",
    "tsup": "^8.5.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.17",
    "@testing-library/react": "^16.3.1",
    "jsdom": "^27.4.0",
    "@vitejs/plugin-react-swc": "^3.9.0"
  }
}
