{
  "name": "@oc-mui/plugin-system",
  "version": "1.0.0",
  "license": "ECL-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "clean": "rm -rf .turbo && rm -rf dist && rm -rf dist-types && rm -rf target && rm -rf node_modules && rm -rf coverage && rm -f *.tsbuildinfo && rm -f tsconfig*.tsbuildinfo",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "build:types": "tsc -p tsconfig.build.json",
    "api-check": "pnpm build:types && api-extractor run --local --verbose",
    "api-check:ci": "pnpm build:types && api-extractor run --verbose",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@oc-mui/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0",
    "@types/react-dom": "^18.0.0 || ^19.0.0",
    "@oc-mui/eslint-config": "workspace:*",
    "@oc-mui/tailwind-config": "workspace:*",
    "@oc-mui/typescript-config": "workspace:*",
    "eslint": "^9.20.0",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.3.3",
    "vitest": "^4.0.17",
    "@testing-library/react": "^16.3.1",
    "jsdom": "^27.4.0",
    "@vitejs/plugin-react-swc": "^3.9.0"
  }
}
