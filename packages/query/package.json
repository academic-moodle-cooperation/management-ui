{
  "name": "@oc-mui/query",
  "version": "1.0.0",
  "description": "Data-fetching and plugin-config facade (TanStack Query) for the Opencast Management UI and its plugins.",
  "author": "Academic Moodle Cooperation",
  "homepage": "https://github.com/academic-moodle-cooperation/management-tool/tree/HEAD/packages/query#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/academic-moodle-cooperation/management-tool.git",
    "directory": "packages/query"
  },
  "bugs": "https://github.com/academic-moodle-cooperation/management-tool/issues",
  "keywords": [
    "opencast",
    "management-ui",
    "oc-mui",
    "plugin",
    "data-fetching",
    "tanstack-query"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "ECL-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "clean": "rm -rf .turbo && rm -rf dist && rm -rf dist-types && rm -rf node_modules && rm -rf coverage && rm -f *.tsbuildinfo && rm -f tsconfig*.tsbuildinfo",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "build:types": "tsc -p tsconfig.build.json",
    "api-check": "pnpm build:types && api-extractor run --local --verbose",
    "api-check:ci": "pnpm build:types && api-extractor run --verbose",
    "codegen": "dotenv -e ../../.env -- graphql-codegen-esm --config src/codegen.ts && node src/fix-fetcher-import.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.51.15",
    "@tanstack/react-query-devtools": "^5.51.15",
    "@oc-mui/plugin-system": "workspace:*",
    "@oc-mui/ui-config": "workspace:*",
    "@oc-mui/utils": "workspace:*",
    "graphql": "^16.9.0",
    "graphql-request": "^7.1.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.2",
    "@graphql-codegen/client-preset": "^4.3.2",
    "@graphql-codegen/typescript": "^4.0.9",
    "@graphql-codegen/typescript-operations": "^4.2.3",
    "@graphql-codegen/typescript-react-query": "^6.1.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^25.0.6",
    "@types/react": "^18.0.0 || ^19.0.0",
    "@oc-mui/eslint-config": "workspace:*",
    "@oc-mui/typescript-config": "workspace:*",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.9.0",
    "jsdom": "^27.4.0",
    "typescript": "~5.5.4",
    "vitest": "^4.0.17"
  }
}
