{
  "extends": "@opencast-mui/typescript-config/react-library.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "rootDir": "src",
    "baseUrl": ".",
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "@opencast-mui/ui/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts", "vite-env.d.ts"],
  "exclude": ["node_modules", "dist", ".turbo"]
}
