{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "incremental": true,
    "tsBuildInfoFile": "dist-types/tsconfig.build.tsbuildinfo",
    "outDir": "dist-types",
    "noEmit": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite-env.d.ts"],
  "exclude": ["node_modules", "dist", "dist-types", ".turbo", "**/*.test.ts", "**/*.test.tsx"]
}
