{
  "name": "@oc-mui/ui",
  "version": "1.0.0",
  "description": "React UI component library (shadcn/ui + Tailwind) for the Opencast Management UI and its plugins.",
  "author": "Academic Moodle Cooperation",
  "homepage": "https://github.com/academic-moodle-cooperation/management-ui/tree/HEAD/packages/ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/academic-moodle-cooperation/management-ui.git",
    "directory": "packages/ui"
  },
  "bugs": "https://github.com/academic-moodle-cooperation/management-ui/issues",
  "keywords": [
    "opencast",
    "management-ui",
    "oc-mui",
    "plugin",
    "ui",
    "react",
    "shadcn",
    "components"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist-types/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist-types/index.d.ts",
        "import": "./dist/index.js"
      },
      "./components": {
        "types": "./dist-types/components/index.d.ts",
        "import": "./dist/components/index.js"
      },
      "./components/*": {
        "types": "./dist-types/components/*.d.ts",
        "import": "./dist/components/*.js"
      },
      "./config-primitives": {
        "types": "./dist-types/config-primitives.d.ts",
        "import": "./dist/config-primitives.js"
      },
      "./hooks": {
        "types": "./dist-types/hooks/index.d.ts",
        "import": "./dist/hooks/index.js"
      },
      "./hooks/*": {
        "types": "./dist-types/hooks/*.d.ts",
        "import": "./dist/hooks/*.js"
      },
      "./lib": {
        "types": "./dist-types/lib/index.d.ts",
        "import": "./dist/lib/index.js"
      },
      "./lib/utils": {
        "types": "./dist-types/lib/utils.d.ts",
        "import": "./dist/lib/utils.js"
      },
      "./styles": {
        "types": "./dist-types/styles/index.d.ts",
        "import": "./dist/styles/index.js"
      },
      "./globals.css": "./dist/styles/globals.css",
      "./postcss.config": "./postcss.config.mjs"
    }
  },
  "license": "ECL-2.0",
  "type": "module",
  "scripts": {
    "clean": "rm -rf .turbo && rm -rf dist && rm -rf dist-types && rm -rf target && rm -rf node_modules && rm -rf coverage && rm -f *.tsbuildinfo && rm -f tsconfig*.tsbuildinfo",
    "build": "tsup",
    "build:types": "tsc -p tsconfig.build.json",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "exports": {
    ".": "./src/index.ts",
    "./components": "./src/components/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./config-primitives": "./src/config-primitives.ts",
    "./hooks": "./src/hooks/index.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib": "./src/lib/index.ts",
    "./lib/utils": "./src/lib/utils.ts",
    "./styles": "./src/styles/index.ts",
    "./globals.css": "./src/styles/globals.css",
    "./postcss.config": "./postcss.config.mjs"
  },
  "files": [
    "dist",
    "dist-types",
    "postcss.config.mjs"
  ],
  "dependencies": {
    "@internationalized/date": "^3.8.1",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@react-stately/datepicker": "^3.14.1",
    "@oc-mui/i18n": "workspace:*",
    "@oc-mui/plugin-system": "workspace:*",
    "@oc-mui/query": "workspace:*",
    "@oc-mui/ui-config": "workspace:*",
    "@oc-mui/utils": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.417.0",
    "next-themes": "^0.4.6",
    "react-aria": "^3.40.0",
    "react-day-picker": "8.10.1",
    "react-stately": "^3.38.0",
    "sonner": "^2.0.6",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^0.0.0-alpha.13",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^25.0.6",
    "@types/react": "^18.0.0 || ^19.0.0",
    "@types/react-dom": "^18.0.0 || ^19.0.0",
    "@oc-mui/eslint-config": "workspace:*",
    "@oc-mui/typescript-config": "workspace:*",
    "eslint": "^9.9.0",
    "jsdom": "^27.4.0",
    "react": "^19.1.0",
    "tailwindcss": "^4.1.7",
    "tsup": "^8.5.0",
    "typescript": "~5.5.4",
    "vitest": "^4.0.17"
  },
  "peerDependencies": {
    "@tanstack/react-table": "^8.19.3",
    "react": "^19.1.0"
  }
}
