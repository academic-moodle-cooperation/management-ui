{
  "name": "@oc-mui/utils",
  "version": "1.0.0",
  "license": "ECL-2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./assetUrl": "./dist/assetUrl.js",
    "./deepMerge": "./dist/deepMerge.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf .turbo && rm -rf dist && rm -rf dist-types && rm -rf node_modules && rm -rf coverage && rm -f *.tsbuildinfo && rm -f tsconfig*.tsbuildinfo",
    "lint": "eslint . --ext .ts,.js --report-unused-disable-directives --max-warnings 0",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "build:types": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "tinyduration": "^3.3.0"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@oc-mui/eslint-config": "workspace:*",
    "@oc-mui/typescript-config": "workspace:*",
    "eslint": "^9.9.0",
    "typescript": "~5.5.4",
    "vitest": "^4.0.17"
  }
}
