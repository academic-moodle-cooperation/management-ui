{
  "extends": "../typescript-config/node-esm-library.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "composite": false,
    "noEmit": false,
    "types": [
      "vitest/globals",
      "node"
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".turbo",
    "**/*.test.ts"
  ]
}