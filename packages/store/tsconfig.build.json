{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "incremental": true,
    "outDir": "dist-types",
    "rootDir": ".",
    "noEmit": false
  },
  "include": ["index.tsx", "atoms.ts", "useStore.ts", "useTableStore.ts"],
  "exclude": ["node_modules", "dist", "dist-types", ".turbo", "**/*.test.ts", "**/*.test.tsx"]
}
