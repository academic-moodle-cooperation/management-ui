{
  "name": "@opencast-mui/store",
  "version": "1.0.0",
  "description": "State-management facade (Jotai) for the Opencast Management UI and its plugins.",
  "author": "Academic Moodle Cooperation",
  "homepage": "https://github.com/academic-moodle-cooperation/management-tool/tree/HEAD/packages/store#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/academic-moodle-cooperation/management-tool.git",
    "directory": "packages/store"
  },
  "bugs": "https://github.com/academic-moodle-cooperation/management-tool/issues",
  "keywords": [
    "opencast",
    "management-ui",
    "opencast-mui",
    "plugin",
    "state",
    "jotai"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist-types/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist-types/index.d.ts",
        "import": "./dist/index.js"
      },
      "./atoms": {
        "types": "./dist-types/atoms.d.ts",
        "import": "./dist/atoms.js"
      },
      "./useStore": {
        "types": "./dist-types/useStore.d.ts",
        "import": "./dist/useStore.js"
      },
      "./useTableStore": {
        "types": "./dist-types/useTableStore.d.ts",
        "import": "./dist/useTableStore.js"
      }
    }
  },
  "license": "ECL-2.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "default": "./index.tsx"
    },
    "./atoms": {
      "types": "./dist-types/atoms.d.ts",
      "default": "./atoms.ts"
    },
    "./useStore": {
      "types": "./dist-types/useStore.d.ts",
      "default": "./useStore.ts"
    },
    "./useTableStore": {
      "types": "./dist-types/useTableStore.d.ts",
      "default": "./useTableStore.ts"
    }
  },
  "files": [
    "dist",
    "dist-types"
  ],
  "scripts": {
    "clean": "rm -rf .turbo && rm -rf dist && rm -rf dist-types && rm -rf node_modules && rm -rf coverage && rm -f *.tsbuildinfo && rm -f tsconfig*.tsbuildinfo",
    "build": "tsup",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "build:types": "tsc -p tsconfig.build.json",
    "api-check": "pnpm build:types && api-extractor run --local --verbose",
    "api-check:ci": "pnpm build:types && api-extractor run --verbose",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "immer": "^10.0.3",
    "jotai": "^2.6.4",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0",
    "@opencast-mui/eslint-config": "workspace:*",
    "@opencast-mui/typescript-config": "workspace:*",
    "eslint": "^9.9.0",
    "tsup": "^8.5.0",
    "typescript": "~5.5.4",
    "vitest": "^4.0.17",
    "@testing-library/react": "^16.3.1",
    "jsdom": "^27.4.0"
  }
}
