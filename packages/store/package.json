{
  "name": "@workspace/store",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./index.tsx",
    "./atoms": "./atoms.ts",
    "./useStore": "./useStore.ts",
    "./useTableStore": "./useTableStore.ts"
  },
  "scripts": {
    "clean": "rm -rf .turbo && rm -rf dist && rm -rf dist-types && rm -rf node_modules && rm -rf coverage && rm -f *.tsbuildinfo && rm -f tsconfig*.tsbuildinfo",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "immer": "^10.0.3",
    "jotai": "^2.6.4",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.9.0",
    "typescript": "~5.5.4",
    "vitest": "^4.0.17",
    "@testing-library/react": "^16.3.1",
    "jsdom": "^27.4.0"
  }
}
