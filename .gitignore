# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
#
# Patterns without a leading slash match at any depth, so for example
# `node_modules` also ignores `plugins/*/node_modules`, `apps/*/node_modules`,
# etc. Do not add redundant `plugins/*/node_modules`-style entries.

# Dependencies
node_modules
.pnp
.pnp.js
.pnpm-store/*
package-lock.json

# Local env files (keep only the tracked example)
.env*
!.env.example

# Build outputs / caches
.next/
out/
build
dist
dist-types
.vite/
.parcel-cache/
.rollup.cache/
.rpt2_cache/

# Testing
coverage
.nyc_output

# Turbo
.turbo

# TypeScript incremental build info
*.tsbuildinfo

# Linter caches
.eslintcache
**/.eslintcache

# Vercel
.vercel

# Maven / Java backend build artifacts
target/

# Debug / log output
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
pids
*.pid
*.seed

# OS / editor junk
.DS_Store
Thumbs.db
*.pem
*.swp
*~
.idea/
.vscode/
vscode
*.code-workspace

# Cursor
.cursorignore
.cursor/

# SpecStory
.specstory/

# Temp / migration scratch dirs (not for committed code)
migrate
tmp/
node/

# Archived docs are kept out of the repo
docs/archive

# Personal workflow tools (owner-specific, not part of the product)
git-workflow.sh
GIT_WORKFLOW.md

# Local development plugins (org / experimental plugins live here during dev)
.local-plugins/
