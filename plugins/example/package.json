{
  "name": "@workspace/plugin-example",
  "version": "1.0.0",
  "license": "ECL-2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "clean": "rm -rf .turbo && rm -rf dist && rm -rf dist-types && rm -rf target && rm -rf node_modules && rm -rf coverage && rm -f *.tsbuildinfo && rm -f tsconfig*.tsbuildinfo",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:contract": "vitest run plugin.contract"
  },
  "dependencies": {
    "@workspace/plugin-system": "workspace:*",
    "@workspace/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.0.6",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/plugin-testing": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.9.0",
    "typescript": "~5.5.4",
    "vitest": "^4.0.17"
  }
}
