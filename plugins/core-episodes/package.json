{
  "name": "@oc-mui/plugin-core-episodes",
  "version": "1.2.1",
  "license": "ECL-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "echo 'core-episodes plugin does not run standalone'",
    "build": "echo 'No build step required for library plugin'",
    "clean": "rm -rf .turbo && rm -rf dist && rm -rf node_modules && rm -f *.tsbuildinfo && rm -f tsconfig*.tsbuildinfo",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:contract": "vitest run plugin.contract"
  },
  "dependencies": {
    "@oc-mui/i18n": "workspace:*",
    "@oc-mui/plugin-core": "workspace:*",
    "@oc-mui/plugin-system": "workspace:*",
    "@oc-mui/query": "workspace:*",
    "@oc-mui/router": "workspace:*",
    "@oc-mui/store": "workspace:*",
    "@oc-mui/ui": "workspace:*",
    "@oc-mui/ui-config": "workspace:*",
    "@oc-mui/utils": "workspace:*",
    "lucide-react": "^0.417.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@oc-mui/eslint-config": "workspace:*",
    "@oc-mui/plugin-testing": "workspace:*",
    "@oc-mui/typescript-config": "workspace:*",
    "@testing-library/react": "^16.3.1",
    "@types/react": "^18.0.0 || ^19.0.0",
    "eslint": "^9.20.0",
    "jsdom": "^27.4.0",
    "react": "~19.2.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.17"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  }
}
