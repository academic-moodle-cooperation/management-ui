{
  "name": "@oc-mui/plugin-core",
  "version": "1.0.0",
  "description": "Core infrastructure plugin: shared extension-point identifiers and defaults that every Opencast Management UI plugin may import.",
  "author": "Academic Moodle Cooperation",
  "homepage": "https://github.com/academic-moodle-cooperation/management-tool/tree/HEAD/plugins/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/academic-moodle-cooperation/management-tool.git",
    "directory": "plugins/core"
  },
  "bugs": "https://github.com/academic-moodle-cooperation/management-tool/issues",
  "keywords": [
    "opencast",
    "management-ui",
    "oc-mui",
    "plugin",
    "plugin-core",
    "extension-points"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "ECL-2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "clean": "rm -rf .turbo && rm -rf dist && rm -rf dist-types && rm -rf target && rm -rf node_modules && rm -rf coverage && rm -f *.tsbuildinfo && rm -f tsconfig*.tsbuildinfo",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@oc-mui/plugin-system": "workspace:*",
    "@oc-mui/ui": "workspace:*",
    "@oc-mui/i18n": "workspace:*",
    "@oc-mui/query": "workspace:*",
    "@oc-mui/router": "workspace:*",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.6",
    "@types/react": "^18.0.0 || ^19.0.0",
    "eslint": "^9.9.0",
    "typescript": "~5.5.4"
  }
}
