{
  "name": "@opencast-mui/plugin-core-series",
  "version": "1.0.0",
  "license": "ECL-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "echo 'core-series plugin does not run standalone'",
    "build": "echo 'No build step required for library plugin'",
    "clean": "rm -rf .turbo && rm -rf dist && rm -rf node_modules && rm -f *.tsbuildinfo && rm -f tsconfig*.tsbuildinfo",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:contract": "vitest run plugin.contract"
  },
  "dependencies": {
    "@opencast-mui/i18n": "workspace:*",
    "@opencast-mui/plugin-system": "workspace:*",
    "@opencast-mui/providers": "workspace:*",
    "@opencast-mui/query": "workspace:*",
    "@opencast-mui/router": "workspace:*",
    "@opencast-mui/store": "workspace:*",
    "@opencast-mui/ui": "workspace:*",
    "@opencast-mui/ui-config": "workspace:*",
    "@opencast-mui/utils": "workspace:*",
    "lucide-react": "^0.417.0",
    "react": "^19.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0",
    "@opencast-mui/eslint-config": "workspace:*",
    "@opencast-mui/plugin-testing": "workspace:*",
    "@opencast-mui/typescript-config": "workspace:*",
    "eslint": "^9.20.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.17"
  }
}
