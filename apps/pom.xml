<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <parent>
    <artifactId>management-tool</artifactId>
    <groupId>org.amc.management</groupId>
    <version>1.0-SNAPSHOT</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>

  <artifactId>management-frontend</artifactId>
  <packaging>pom</packaging>

  <properties>
    <opencast.basedir>${project.basedir}/..</opencast.basedir>
  </properties>

  <name>Opencast Management Tool :: UI</name>
  <modules>
    <module>management-ui-core</module>
    <module>management-ui-episodes</module>
    <module>management-ui-series</module>
    <module>management-ui-upload</module>
    <module>management-ui-test</module>
  </modules>

  <dependencies>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>install node and pnpm</id>
            <phase>initialize</phase>
            <goals>
              <goal>install-node-and-pnpm</goal>
            </goals>
          </execution>
        </executions>
        <inherited>false</inherited>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>pnpm install</id>
            <phase>initialize</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${maven.multiModuleProjectDirectory}/node/node</executable>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/node/node_modules/pnpm/bin/pnpm.cjs</argument>
                <argument>install</argument>
                <argument>--engine-strict</argument>
              </arguments>
              <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
              <environmentVariables>
                <PATH>${maven.multiModuleProjectDirectory}/node:${env.PATH}</PATH>
              </environmentVariables>
            </configuration>
          </execution>
        </executions>
        <inherited>false</inherited>
      </plugin>
      <plugin>
        <groupId>org.apache.felix</groupId>
        <artifactId>maven-bundle-plugin</artifactId>
        <extensions>true</extensions>
      </plugin>
    </plugins>
  </build>
</project>
