<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <parent>
    <artifactId>management-frontend</artifactId>
    <groupId>org.amc.management</groupId>
    <version>1.0-SNAPSHOT</version>
  </parent>
  <modelVersion>4.0.0</modelVersion>

  <artifactId>management-ui-series</artifactId>
  <packaging>bundle</packaging>

  <name>Opencast Management Tool :: UI :: Plugin series</name>
  <properties>
    <opencast.basedir>${project.basedir}/../..</opencast.basedir>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>
        <configuration>
          <workingDirectory>${project.basedir}/../..</workingDirectory>
          <installDirectory>${project.basedir}/../..</installDirectory>
        </configuration>
        <executions>
          <execution>
            <id>pnpm build</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>pnpm</goal>
            </goals>
            <configuration>
              <arguments>run build --filter=management-ui-series</arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-resources</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${basedir}/target/classes/ui/static/plugins/series</outputDirectory>
              <resources>
                <resource>
                  <directory>${basedir}/dist</directory>
                  <filtering>false</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.felix</groupId>
        <artifactId>maven-bundle-plugin</artifactId>
        <configuration>
          <instructions>
            <Private-Package>ui.*</Private-Package>
            <Management-Plugin>series</Management-Plugin>
            <Fragment-Host>management-ui-core</Fragment-Host>
          </instructions>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <groupId>org.amc.management</groupId>
      <artifactId>management-ui-core</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

</project>
