{
  "extends": "@workspace/typescript-config/react-application.json",
  "compilerOptions": {
    "baseUrl": ".",
    "skipLibCheck": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@monorepo-apps/*": [
        "../../apps/*"
      ]
    }
  },
  "include": [
    "src",
    "vite-env.d.ts",
    "vite.config.ts",
    "postcss.config.mjs",
    "tailwind.config.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".turbo",
    "../../packages/ui/src/components/ui/**/*"
  ]
}