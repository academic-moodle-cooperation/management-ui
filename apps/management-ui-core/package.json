{
  "name": "management-ui-core",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "clean": "rm -rf .turbo && rm -rf dist && rm -rf target && rm -rf node_modules",
    "check-types": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.80.6",
    "@tanstack/react-router": "^1.115.8",
    "@workspace/i18n": "workspace:*",
    "@workspace/plugin-system": "workspace:*",
    "@workspace/plugins": "workspace:*",
    "@workspace/providers": "workspace:*",
    "@workspace/query": "workspace:*",
    "@workspace/ui": "workspace:*",
    "@workspace/ui-config": "workspace:*",
    "@workspace/router": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tanstack/router-devtools": "^1.125.6",
    "@tailwindcss/vite": "^4.1.7",
    "@tanstack/react-query-devtools": "^5.80.6",
    "@types/react": "^18.0.0 || ^19.0.0",
    "@types/react-dom": "^18.0.0 || ^19.0.0",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vite-config": "workspace:*",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.20.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.7",
    "typescript": "~5.5.4",
    "vite": "^6.1.4"
  }
