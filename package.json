{
  "name": "management-ui",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "clean": "rm -rf .turbo && rm -rf dist && rm -rf target && rm -rf node_modules && turbo run clean",
    "preview": "turbo run preview",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@swc/helpers": "^0.5.17",
    "prettier": "^3.5.3",
    "turbo": "^2.5.5",
    "typescript": "5.8.2"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "lucide-react": "^0.417.0"
  }
}