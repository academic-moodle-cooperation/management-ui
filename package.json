{
  "name": "management-ui",
  "private": true,
  "license": "ECL-2.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "create-plugin": "node ./scripts/create-plugin.mjs",
    "clean": "turbo run clean && rm -rf .turbo && rm -rf dist && rm -rf dist-types && rm -rf target && rm -rf node_modules && rm -rf coverage && rm -f *.tsbuildinfo && rm -f tsconfig*.tsbuildinfo && find . -name '.eslintcache' -delete",
    "clean:plugins": "turbo run clean --filter=./plugins/* --filter=./.local-plugins/*",
    "preview": "turbo run preview",
    "lint": "turbo run lint --filter='!./.local-plugins/*'",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,scss,md,html,yaml,yml,graphql}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,scss,md,html,yaml,yml,graphql}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "test:contract": "turbo run test:contract",
    "verify": "mkdir -p .local-plugins && pnpm turbo run lint check-types build test test:contract api-check --filter='!./.local-plugins/*' && pnpm test:e2e",
    "validate:plugins": "node scripts/validate-plugins.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:matrix": "playwright test --config=playwright.matrix.config.ts",
    "test:matrix:install": "playwright install --with-deps chromium firefox webkit",
    "test:integration": "playwright test --config=playwright.integration.config.ts",
    "test:integration:ui": "playwright test --config=playwright.integration.config.ts --ui",
    "har:sanitize": "node ./scripts/sanitize-har.mjs",
    "protocol:import": "node ./scripts/protocol-import.mjs",
    "protocol:coverage": "node ./scripts/protocol-coverage.mjs",
    "test:har-replay": "playwright test --config=playwright.har-replay.config.ts",
    "test:org-plugin": "playwright test --config=playwright.org-plugin.config.ts",
    "test:org-plugin:update": "playwright test --config=playwright.org-plugin.config.ts --update-snapshots",
    "test:jar-deploy": "bash scripts/verify-jar-deploy.sh",
    "test:sdk-publish": "bash scripts/verify-sdk-publish.sh",
    "sdk:sandbox": "bash scripts/sdk-sandbox.sh",
    "test:scaffold": "bash scripts/verify-scaffold.sh",
    "test:docs": "bash scripts/verify-docs.sh",
    "test:local-plugin": "playwright test --config=playwright.local-plugin.config.ts",
    "test:marketplace": "playwright test --config=playwright.marketplace.config.ts",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "test:visual:update": "playwright test --config=playwright.visual.config.ts --update-snapshots",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version && node scripts/bump-product-version.mjs",
    "changeset:publish": "changeset publish",
    "changeset:tag": "changeset tag",
    "api-check": "turbo run api-check",
    "api-check:ci": "turbo run api-check:ci",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@microsoft/api-extractor": "^7.58.7",
    "@playwright/test": "^1.59.1",
    "@swc/helpers": "^0.5.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.6",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.5.3",
    "turbo": "^2.10.2",
    "typescript": "5.8.2",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "lucide-react": "^0.417.0"
  },
  "pnpm": {
    "overrides": {
      "vite-plugin-static-copy@>=0.4.3 <=2.3.1": ">=2.3.2 <4.0.0",
      "postcss@>=8.0.0 <8.5.10": ">=8.5.10",
      "yaml@>=2.0.0 <3.0.0": ">=2.8.3",
      "js-yaml@>=4.0.0 <5.0.0": "4.2.0",
      "tmp": ">=0.2.6",
      "vite@>=7.0.0 <8.0.0": ">=7.3.5 <8.0.0",
      "vite@>=6.0.0 <7.0.0": ">=6.4.3 <7.0.0",
      "vitest@>=4.0.0 <4.1.0": "4.1.9",
      "shell-quote": ">=1.8.4",
      "tar": ">=7.5.16",
      "ws@>=8.0.0 <9.0.0": "8.21.0",
      "seroval": ">=1.4.1",
      "rollup": ">=4.59.0",
      "immutable@>=3.0.0 <4.0.0": "3.8.3",
      "flatted": ">=3.4.2"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "@tailwindcss/oxide",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
