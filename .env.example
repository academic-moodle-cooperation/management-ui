# GraphQL Configuration (used by `pnpm --filter @oc-mui/query schema:refresh`
# — codegen itself reads the committed packages/query/src/schema.graphql and
# needs no backend)
GRAPHQL_ENDPOINT=http://127.0.0.1:8080/graphql
GRAPHQL_HEADERS={}

# Dev server → backend proxy.
# Where `pnpm dev` proxies all backend traffic (GraphQL, auth, uploads,
# config.json, media, …). Defaults to http://localhost:8080 when unset.
# Leave unset to run with no backend (the committed default config.json is
# served locally and backend calls show a "not reachable" notice).
# VITE_PROXY_TARGET=https://your-opencast.example.org

# Force the committed apps/shell/public/ui/config/management-ui/config.json to
# be served locally even when VITE_PROXY_TARGET is set — so you can edit config
# (theme, enabledPlugins, plugin slices) against the backend's real data/auth.
# Only affects the config path; everything else still hits the backend.
# VITE_LOCAL_CONFIG=true

# Example external API (consumed by an org plugin, e.g. an event-calendar integration)
VITE_EXAMPLE_API_BASE_URL=https://api.example.com

# Development
NODE_ENV=development
